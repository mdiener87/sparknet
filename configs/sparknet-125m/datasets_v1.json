{
  "_comment": "Train corpus for sparknet-125m-v1. num_shards buckets documents by content hash so the 5 shards are disjoint (fixes the 410m-v1 streaming-from-0 duplication bug). 5 shards x 500M = 2.5B unique tokens.",
  "seed": 42,
  "tokenizer_path": "./tokenizer-v8",
  "output_root": "datasets/sparknet-125m-v1-pretrain",
  "partition": "train",
  "num_shards": 5,
  "holdout_rate": 0.02,
  "holdout_salt": "sparknet-125m-v1",
  "chatml_wrap_rate": 0.005,
  "long_text_chunk_chars": 200000,
  "block_size": 1024,
  "shard_tokens": 500000000,
  "writer_batch_size": 50000,
  "report_tokens_every": 10000000,
  "sources": [
    {
      "name": "HuggingFaceFW/fineweb-edu",
      "split": "train",
      "prob": 0.44,
      "text_fields": ["text"]
    },
    {
      "name": "mlfoundations/dclm-baseline-1.0",
      "split": "train",
      "prob": 0.13,
      "text_fields": ["text"]
    },
    {
      "name": "HuggingFaceFW/finepdfs",
      "config_name": "eng_Latn",
      "split": "train",
      "prob": 0.11,
      "text_fields": ["text"]
    },
    {
      "name": "HuggingFaceFW/finewiki",
      "config_name": "en",
      "split": "train",
      "prob": 0.10,
      "text_fields": ["text"]
    },
    {
      "name": "HuggingFaceTB/smollm-corpus",
      "config_name": "cosmopedia-v2",
      "split": "train",
      "prob": 0.10,
      "text_fields": ["text"]
    },
    {
      "name": "kejian/codesearchnet-python-raw",
      "split": "train",
      "prob": 0.07,
      "text_fields": ["code"]
    },
    {
      "name": "open-web-math/open-web-math",
      "split": "train",
      "prob": 0.05,
      "text_fields": ["text"]
    }
  ]
}
