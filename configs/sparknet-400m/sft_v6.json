{
  "run_name": "sparknet-400m-v2-instruct-v1-short",
  "model_path": "checkpoints/sparknet-400m-v2-12b/checkpoint-12000",
  "tokenizer_path": "./tokenizer-v6",
  "train_root": "datasets/sft_chat_v6",
  "block_size": 1024,
  "bf16": true,
  "gradient_checkpointing": false,
  "per_device_train_batch_size": 16,
  "per_device_eval_batch_size": 16,
  "grad_accum": 8,
  "learning_rate": 2e-05,
  "weight_decay": 0.0,
  "warmup_ratio": 0.03,
  "scheduler": "cosine",
  "max_grad_norm": 1.0,
  "target_tokens": 150000000,
  "eval_fraction": 0.02,
  "eval_steps": 100,
  "output_dir": "checkpoints/sparknet-400m-v2-instruct-v1-short",
  "logging_steps": 25,
  "save_steps": 100,
  "save_total_limit": 6,
  "dataloader_num_workers": 8,
  "dataloader_prefetch_factor": 4,
  "sample_prompts_path": "configs/sparknet-400m/sft_eval_prompts_v6.json",
  "sample_max_new_tokens": 128,
  "sample_temperature": 0.0,
  "sample_top_p": 0.9,
  "sample_top_k": 0,
  "sample_repetition_penalty": 1.12,
  "sample_no_repeat_ngram_size": 4
}
