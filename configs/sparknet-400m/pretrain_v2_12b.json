{
  "run_name": "sparknet-400m-v2-12b",
  "seed": 42,
  "tokenizer_path": "./tokenizer-v6",
  "train_root": "datasets/sparknet-v2-pretrain",
  "block_size": 1024,
  "hidden_size": 1024,
  "num_layers": 29,
  "num_heads": 16,
