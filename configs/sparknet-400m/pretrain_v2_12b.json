  "logging_steps": 50,
  "eval_steps": 500,
  "save_steps": 1000,
  "save_total_limit": 5,
  "dataloader_num_workers": 16,
  "dataloader_prefetch_factor": 4,
  "limit_shards": null,
  "resume_from": null,
  "do_sample_generations": true,
  "sample_gen_every_eval": true,
  "sample_prompts_path": null
}
