    },
    {
      "name": "codelion/dclm-baseline-100M",
      "split": "train",
      "prob": 0.15,
      "text_fields": ["text"]
    },
    {
      "name": "codelion/finepdfs-100M",
      "split": "train",
      "prob": 0.15,
      "text_fields": ["text"]
    },
    {
      "name": "codelion/finewiki-100M",
      "split": "train",
      "prob": 0.1,
      "text_fields": ["text"]
    },
    {
      "name": "HuggingFaceTB/cosmopedia-100k",
      "split": "train",
      "prob": 0.1,
      "text_fields": ["text"]
    }
  ]
}
